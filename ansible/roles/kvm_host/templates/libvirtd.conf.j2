listen_tls = 1
listen_tcp = 0

unix_sock_group = "libvirt"
unix_sock_ro_perms = "0770"
unix_sock_rw_perms = "0770"

auth_unix_ro = "none"
auth_unix_rw = "none"

max_clients = 1024
max_queued_clients = 256
max_workers = 20
max_client_requests = 50

log_level = 1
log_filters = "1:libvirt 1:qemu 3:event"
log_outputs = "1:file:/var/log/libvirt/libvirtd.log"

keepalive_interval = 5
keepalive_count = 5
